# name: test/sql/test_multiwriter.test
# description: Basic tests for the multiwriter extension
# group: [multiwriter]

require multiwriter
require parquet

# -------------------------------------------------------
# 1. Create a multiwriter database
# -------------------------------------------------------

statement ok
SELECT mwdb_create('__TEST_DIR__/mwdb_test');

# -------------------------------------------------------
# 2. Create tables
# -------------------------------------------------------

statement ok
SELECT mwdb_create_table('__TEST_DIR__/mwdb_test', 'events', 'id INTEGER PRIMARY KEY, label VARCHAR, value DOUBLE');

statement ok
SELECT mwdb_create_table('__TEST_DIR__/mwdb_test', 'users', 'user_id BIGINT, name VARCHAR');

# -------------------------------------------------------
# 3. mwdb_info: database starts with two tables, no segments
# -------------------------------------------------------

query IIIII
SELECT table_name, entry_type, segment_count, live_segments, row_count FROM mwdb_info('__TEST_DIR__/mwdb_test') ORDER BY table_name;
----
events	TABLE	0	0	0
users	TABLE	0	0	0

# -------------------------------------------------------
# 4. Write data into 'events'
# -------------------------------------------------------

statement ok
SELECT mwdb_write('__TEST_DIR__/mwdb_test', 'events',
    'SELECT 1 AS id, ''alpha'' AS label, 1.5 AS value
     UNION ALL SELECT 2, ''beta'', 2.5
     UNION ALL SELECT 3, ''gamma'', 3.5');

# After writing, info should show 1 segment with 3 rows
query IIII
SELECT table_name, segment_count, live_segments, row_count FROM mwdb_info('__TEST_DIR__/mwdb_test') WHERE table_name = 'events';
----
events	1	1	3

# -------------------------------------------------------
# 5. Write a second segment
# -------------------------------------------------------

statement ok
SELECT mwdb_write('__TEST_DIR__/mwdb_test', 'events',
    'SELECT 4 AS id, ''delta'' AS label, 4.5 AS value
     UNION ALL SELECT 5, ''epsilon'', 5.5');

query IIII
SELECT table_name, segment_count, live_segments, row_count FROM mwdb_info('__TEST_DIR__/mwdb_test') WHERE table_name = 'events';
----
events	2	2	5

# -------------------------------------------------------
# 6. Scan all rows
# -------------------------------------------------------

query III
SELECT id, label, value FROM mwdb_scan('__TEST_DIR__/mwdb_test', 'events') ORDER BY id;
----
1	alpha	1.5
2	beta	2.5
3	gamma	3.5
4	delta	4.5
5	epsilon	5.5

# -------------------------------------------------------
# 7. PK lookup
# -------------------------------------------------------

query III
SELECT id, label, value FROM mwdb_lookup('__TEST_DIR__/mwdb_test', 'events', '3') ORDER BY id;
----
3	gamma	3.5

# -------------------------------------------------------
# 8. Write into users table
# -------------------------------------------------------

statement ok
SELECT mwdb_write('__TEST_DIR__/mwdb_test', 'users',
    'SELECT 100::BIGINT AS user_id, ''alice'' AS name
     UNION ALL SELECT 200, ''bob''');

query II
SELECT user_id, name FROM mwdb_scan('__TEST_DIR__/mwdb_test', 'users') ORDER BY user_id;
----
100	alice
200	bob

# -------------------------------------------------------
# 9. mwdb_write returns correct row count
# -------------------------------------------------------

query I
SELECT (mwdb_write('__TEST_DIR__/mwdb_test', 'events',
    'SELECT 10 AS id, ''zeta'' AS label, 10.0 AS value')).rows_written;
----
1

# -------------------------------------------------------
# 10. Empty scan on table with no segments
# -------------------------------------------------------

statement ok
SELECT mwdb_create_table('__TEST_DIR__/mwdb_test', 'empty_tbl', 'x INTEGER');

query I
SELECT COUNT(*) FROM mwdb_scan('__TEST_DIR__/mwdb_test', 'empty_tbl');
----
0

# -------------------------------------------------------
# 11. mwdb_create on existing path is idempotent
# -------------------------------------------------------

statement ok
SELECT mwdb_create('__TEST_DIR__/mwdb_test');
